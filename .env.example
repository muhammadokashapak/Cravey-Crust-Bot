# ─── Bot Core ──────────────────────────────────────────────
PORT=3000
SERVER_IP=201.18.214.97
PREFIX=.
OWNER_NUMBER=923001234567
OPENAI_API_KEY=

# ─── Dashboard Auth ─────────────────────────────────────────
DASHBOARD_USER=admin
DASHBOARD_PASS=xortlogix
# AUTH_SECRET is auto-generated if not set (recommended to leave blank)

# ─── n8n Integration ────────────────────────────────────────
# Set N8N_ENABLED=false to disable n8n forwarding for debugging
N8N_ENABLED=true

# The n8n Webhook URL (from your Webhook node in n8n, production URL)
N8N_WEBHOOK_URL=https://your-n8n-domain.com/webhook/whatsapp-incoming

# A long random secret shared between this bot and n8n.
# Generate one with: openssl rand -hex 32
# This is sent as X-Bot-Secret header in both directions.
N8N_BOT_SECRET=change-this-to-a-long-random-secret

# Timeout in milliseconds for the outgoing n8n webhook POST (default: 10000)
N8N_TIMEOUT=10000

# ─── Phase 1: PostgreSQL Database ────────────────────────────
# PostgreSQL credentials (used by Docker Compose postgres service)
POSTGRES_DB=cravey_crust
POSTGRES_USER=cravey
POSTGRES_PASSWORD=change-this-strong-password-minimum-32-chars

# Full Prisma database connection URL
# In Docker: use service name 'cravey-postgres' as host
# Local dev: use 'localhost' with the mapped port
DATABASE_URL=postgresql://cravey:change-this-strong-password-minimum-32-chars@cravey-postgres:5432/cravey_crust

# ─── Phase 1: Redis (optional cache/session layer) ────────────
REDIS_PASSWORD=change-this-redis-password-minimum-32-chars
REDIS_URL=redis://:change-this-redis-password-minimum-32-chars@cravey-redis:6379

# ─── Feature Flags ────────────────────────────────────────────
# ALL flags default to false — existing system remains fully operational.
#
# RESTAURANT_DB_ENABLED
#   false = bot works exactly as before (n8n + Google Sheets)
#   true  = Prisma connects to PostgreSQL (enable after testing)
RESTAURANT_DB_ENABLED=false

# CORE_ORDER_ENGINE_ENABLED
#   false = orders still go through n8n/Google Sheets
#   true  = orders stored in PostgreSQL (enable in Phase 4)
CORE_ORDER_ENGINE_ENABLED=false

# CUSTOM_AI_ENABLED
#   false = uses existing Gemini via n8n
#   true  = uses self-hosted custom AI model (enable in Phase 7)
CUSTOM_AI_ENABLED=false

# REALTIME_DASHBOARD_ENABLED
#   false = dashboard uses polling/manual refresh
#   true  = Socket.IO real-time order events (enable in Phase 4)
REALTIME_DASHBOARD_ENABLED=false

# ─── Phase 2: Restaurant Dashboard & Internal APIs ─────────
# Secret for internal bot-to-backend APIs (GET /api/internal/menu, etc.)
INTERNAL_API_SECRET=cravey-internal-secret-phase2

# n8n workflow integration flag (keep false until complete core stack is ready)
N8N_INTEGRATION_ENABLED=false

# ─── Custom AI Model (Phase 7) ────────────────────────────────
# Only used when CUSTOM_AI_ENABLED=true
AI_PROVIDER=custom
CUSTOM_AI_BASE_URL=http://cravey-ai:8000
CUSTOM_AI_MODEL=cravey-model-v1
CUSTOM_AI_API_KEY=optional-internal-secret
KNOWLEDGE_BASE_ENABLED=true
WHATSAPP_ORDERING_ENABLED=false
