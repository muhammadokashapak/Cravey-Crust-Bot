{
  "name": "whatsapp-bot",
  "version": "1.0.0",
  "description": "Production-ready WhatsApp automation bot using Baileys",
  "main": "bot.js",
  "type": "module",
  "scripts": {
    "start": "node bot.js",
    "dev": "node bot.js",
    "db:generate": "./node_modules/.bin/prisma generate",
    "db:migrate": "./node_modules/.bin/prisma migrate dev",
    "db:deploy": "./node_modules/.bin/prisma migrate deploy",
    "db:studio": "./node_modules/.bin/prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:reset": "./node_modules/.bin/prisma migrate reset",
    "test": "node --test tests/*.test.js",
    "test:flags": "node --test tests/flags.test.js",
    "test:env": "node --test tests/env.test.js",
    "test:schema": "node --test tests/schema.test.js",
    "test:db": "node --test tests/db.test.js",
    "test:faq": "node --test tests/phase4_5*.test.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "automation",
    "baileys"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@whiskeysockets/baileys": "^6.7.16",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "link-preview-js": "^3.0.5",
    "multer": "^2.4.0",
    "openai": "^4.77.0",
    "pino": "^9.6.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.33.5",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "playwright": "^1.64.0"
  }
}
